// Prisma schema for TypingJoy — typing tutor app
// Infrastructure layer: database models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Lesson {
  id              String          @id @default(cuid())
  title           String
  description     String
  difficulty      String          // beginner | intermediate | advanced
  focus           String          // home-row | top-row | bottom-row | numbers | symbols | mixed
  content         String
  estimatedMinutes Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  sessions        TypingSession[]
}

model TypingSession {
  id              String              @id @default(cuid())
  lessonId        String?
  lesson          Lesson?             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  customTextId    String?
  customText      CustomPracticeText? @relation(fields: [customTextId], references: [id], onDelete: Cascade)
  typedText       String
  targetText      String
  wpm             Float
  accuracy        Float
  mistakes        Int
  durationSeconds Int
  completedAt     DateTime            @default(now())

  @@index([lessonId])
  @@index([customTextId])
}

model CustomPracticeText {
  id        String          @id @default(cuid())
  title     String
  body      String
  tags      String          // comma-separated tags
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  sessions  TypingSession[]
}